# {{ ansible_managed }}

SUSHY_EMULATOR_LIBVIRT_URI = "{{ sushy_libvirt_uri }}"

# All interfaces *inside* the container; the host side is narrowed by the
# published port binding instead. The image entrypoint greps for this exact
# assignment and appends "--interface ::" when it is missing.
SUSHY_EMULATOR_LISTEN_IP = "::"
SUSHY_EMULATOR_LISTEN_PORT = {{ sushy_container_port }}

SUSHY_EMULATOR_STATE_DIR = "{{ sushy_state_dir }}"

# sushy defaults this to a pool named "default", which does not exist on hosts
# that keep a pool per project.
SUSHY_EMULATOR_STORAGE_POOL = "{{ libvirt_pool_name }}"
SUSHY_EMULATOR_FEATURE_SET = "{{ sushy_feature_set }}"

# Validated at startup, so a malformed file fails the emulator rather than the
# first request against it.
SUSHY_EMULATOR_AUTH_FILE = "{{ sushy_auth_file }}"

# SUSHY_EMULATOR_ALLOWED_INSTANCES is left unset on purpose: omitting the key
# serves every domain on the host, which is what local and CI environments want.
# Defining it at all -- even as an empty list -- denies everything not listed.

SUSHY_EMULATOR_SSL_CERT = "{{ sushy_tls_cert }}"
SUSHY_EMULATOR_SSL_KEY = "{{ sushy_tls_key }}"
